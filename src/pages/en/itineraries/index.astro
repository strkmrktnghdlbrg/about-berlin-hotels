---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { guides, guideHrefEn } from "../../../data/guides";
import { attractionImages, districtImages } from "../../../data/images";
import FigureImage from "../../../components/FigureImage.astro";
import GetYourGuideWidget from "../../../components/GetYourGuideWidget.astro";

const locale = "en" as const;
---

<BaseLayout
  title="Berlin Itineraries - Ready-Made 1 to 3 Day Plans"
  description="Hour-by-hour Berlin itineraries: the 3-day first-timer classic, Berlin with kids and a rainy-day plan, each linked to real attractions, neighborhoods and hotels."
  locale={locale}
  alternatePath="/reiseplaner/"
>
  <section class="relative overflow-hidden gradient-spree text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 py-16 sm:py-20">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 backdrop-blur-sm border border-white/20 px-3 py-1 text-[11px] font-bold uppercase tracking-widest mb-5">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-200 animate-pulse"></span>
        Itineraries
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-balance mb-6 leading-[1.05]">
        Curated Berlin plans, ready to follow
      </h1>
      <p class="text-lg sm:text-xl text-brand-50/95 leading-relaxed max-w-3xl text-balance">
        Time slots, named sights, transit and restaurant tips, and at the end of
        every plan a hotel suggestion that actually fits the neighborhood you
        just spent the day in.
      </p>
    </div>
  </section>

  <section class="pt-14 sm:pt-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 space-y-4 text-lg text-ink-700 leading-relaxed">
      <p>
        Berlin is big. It covers roughly eight times the area of Paris inside its city limits, and
        the most common mistake on a short trip is not which sights you pick but the order you pick
        them in. Put Museum Island,
        the East Side Gallery and Charlottenburg Palace in one day and you will spend a solid two
        hours on the U-Bahn getting between them. These plans are sorted by route, not by ranking.
      </p>
      <p>
        Each one groups places you can reach on foot or on a single train line, gives a realistic
        time window per stop, and ends in a neighborhood where staying the night makes sense. They
        also mix and match: the three-day classic covers the landmarks, while the family day and
        the rainy-day plan are built to swap in for a single day when the weather or your traveling
        companions change the plan.
      </p>
      <p>
        Not sure yet how long you need, or still deciding what to see at all? Start with the full
        list of <a href="/en/things-to-do-in-berlin/" class="font-semibold text-brand-700 underline decoration-brand-200 underline-offset-2 hover:text-brand-800">things to do in Berlin</a>,
        then come back and pick the plan that matches your days on the ground.
      </p>
    </div>
  </section>

  <section class="py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {guides.map((g) => {
          const image =
            g.imageKey?.folder === "sights"
              ? attractionImages[g.imageKey.slug]
              : g.imageKey?.folder === "districts"
                ? districtImages[g.imageKey.slug]
                : undefined;
          return (
            <a
              href={guideHrefEn(g)}
              class="group block overflow-hidden rounded-2xl border border-ink-100 bg-white hover:border-brand-300 hover:shadow-md transition-all"
            >
              <div class="relative h-48">
                {image ? (
                  <FigureImage image={image} alt={g.title.en} variant="card" />
                ) : (
                  <div class="absolute inset-0 gradient-spree"></div>
                )}
              </div>
              <div class="p-5">
                <div class="text-xs font-bold text-brand-700 uppercase tracking-widest mb-2">
                  {g.duration} {g.duration === 1 ? "Day" : "Days"} · {g.audience.en}
                </div>
                <h2 class="text-xl font-bold text-ink-900 mb-2 group-hover:text-brand-700">
                  {g.title.en}
                </h2>
                <p class="text-sm text-ink-600 leading-relaxed line-clamp-3">
                  {g.description.en}
                </p>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="py-14 sm:py-16 surface-soft">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <GetYourGuideWidget
        mode="city"
        cityQuery="Berlin"
        numberOfItems={4}
        cmp="itineraries-city"
        locale={locale}
        title="Tours & tickets that fit every plan"
        lead="Guided city walks, museum entry and experiences - perfect add-ons for any day plan."
        framed={false}
      />
    </div>
  </section>
</BaseLayout>
